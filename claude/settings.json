{
  "alwaysThinkingEnabled": false,
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "$HOME/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "$HOME/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "$HOME/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "$HOME/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "$HOME/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "$HOME/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "$HOME/.claude/hooks/export-session.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "$HOME/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "$HOME/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "$HOME/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "$HOME/.config/iterm2/cc-status",
            "type": "command"
          }
        ]
      }
    ]
  }
}
