[alias]
	co = checkout
	st = status
	ci = commit
	df = diff
	lg = log
	br = branch
	unstage = reset HEAD --
	last = log -1 HEAD
[user]
	name = Josh Rowley
	email = joshua.f.rowley@gmail.com
	signingkey = 9C06EAF5A96D33F1
[core]
	editor = code --wait
	ignorecase = false
[color]
	ui = auto
[push]
	default = simple
	autoSetupRemote = true
[filter "hawser"]
	clean = git hawser clean %f
	smudge = git hawser smudge %f
	required = true
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[init]
	templatedir = /Users/joshrowley/.git-templates
	defaultBranch = main
[credential]
	helper = osxkeychain
[commit]
	gpgsign = true
